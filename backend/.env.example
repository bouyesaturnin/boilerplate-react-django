# ── Obligatoire ───────────────────────────────────────────────────────────────
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=remplace-par-une-vraie-cle-secrete

# ── Développement ─────────────────────────────────────────────────────────────
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Production ────────────────────────────────────────────────────────────────
# Les listes sont séparées par des virgules ; les éléments vides sont ignorés.
# DEBUG=False
# ALLOWED_HOSTS=mondomaine.com,www.mondomaine.com
# CORS_ALLOWED_ORIGINS=https://mondomaine.com

# Origines HTTPS autorisées à soumettre des formulaires (admin) si elles diffèrent du domaine servi
# CSRF_TRUSTED_ORIGINS=https://mondomaine.com

# Derrière un proxy de confiance qui fixe X-Forwarded-Proto (Railway, Heroku, Nginx...) : True.
# Laisser à False sans proxy : l'en-tête serait falsifiable par le client.
# TRUST_PROXY_SSL_HEADER=False

# Nombre de proxys de confiance pour lire l'IP client (limitation de débit).
# 0 (défaut) : X-Forwarded-For ignoré. À mesurer sur l'hébergeur avant de changer.
# DRF_NUM_PROXIES=0

# HSTS preload : engagement durable pour tout le domaine parent. Laisser à False sauf décision explicite.
# SECURE_HSTS_PRELOAD=False

# Chemin de l'admin (défaut : admin). Lettres, chiffres, - et _ ; ni « api » ni « static ».
# Un chemin peu devinable réduit le bruit des robots mais ne remplace pas l'authentification.
# DJANGO_ADMIN_PATH=gestion-a-personnaliser

# Base de données PostgreSQL (laisser vide pour SQLite en dev)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
